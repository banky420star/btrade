# SB1 ALPHA Configuration
BROKER=paper
SYMBOL=XAUUSD
TIMEFRAME=1h
RISK_PER_TRADE=0.01
MAX_DRAWDOWN_PCT=0.2

# Bybit Configuration
BYBIT_KEY=
BYBIT_SECRET=
BYBIT_TESTNET=true

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MT5 Bridge
BRIDGE_PORT=5010
MT5_BRIDGE_HOST=localhost

# ML/RL Configuration
ML_RETRAIN_HOURS=24
RL_EPOCHS=10
RL_BATCH_SIZE=32
RL_LEARNING_RATE=0.001

# Data Configuration
DATA_SOURCE=bybit
CACHE_DIR=./runtime/cache
MODEL_DIR=./models

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/sb1_alpha.log

# API Configuration
API_PORT=3001
API_HOST=localhost